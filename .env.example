# Admin dashboard — required for /admin login (set in .env.local)
ADMIN_PASSWORD=your-password-here

# Used to sign the admin session cookie — use a long random string in production
ADMIN_SECRET=change-me-to-a-long-random-secret

# Optional: full public site URL (no trailing slash) for WhatsApp prefill links when Host headers are missing (e.g. some CI)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
